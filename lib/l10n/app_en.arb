  "aboutTitle": "About TableLab",
  "@aboutTitle": {
    "description": "About screen AppBar title; TableLab is the app name — keep it."
  },
  "aboutTagline": "Your edge, quantified.",
  "@aboutTagline": {
    "description": "App tagline under the logo."
  },
  "aboutQuote": "Most players keep results in their head.\nThe best players keep them in a database.",
  "@aboutQuote": {
    "description": "Two-line opening statement; keep the line break."
  },
  "aboutIntro": "Poker rewards pattern recognition — and TableLab is built to surface yours. Maybe your best game is live $2/$5 on Saturday nights. Maybe you leak chips in every online session past midnight. Maybe you haven't noticed yet. TableLab notices.",
  "@aboutIntro": {
    "description": "Intro paragraph; $2/$5 is a stakes level — keep it."
  },
  "aboutFeatureSessionTrackerTitle": "Session Tracker",
  "@aboutFeatureSessionTrackerTitle": {
    "description": "About feature title."
  },
  "aboutFeatureSessionTrackerBody": "Log every cash game and tournament — buy-ins, rake, duration, location, table quality, and more. Your history, always at hand, never in a spreadsheet named \"poker stuff v3 FINAL.xlsx\".",
  "@aboutFeatureSessionTrackerBody": {
    "description": "About feature body."
  },
  "aboutFeatureAnalyticsTitle": "Deep Analytics",
  "@aboutFeatureAnalyticsTitle": {
    "description": "About feature title."
  },
  "aboutFeatureAnalyticsBody": "Profit over time, win rates by stakes, location, game type, day of week, and time of day. Statistical recommendations that flag where you're actually making money — not where you think you are.",
  "@aboutFeatureAnalyticsBody": {
    "description": "About feature body."
  },
  "aboutFeatureReplayerTitle": "Hand Replayer",
  "@aboutFeatureReplayerTitle": {
    "description": "About feature title."
  },
  "aboutFeatureReplayerBody": "Record hands from memory and replay them frame-by-frame on a full table view. Cash and tournament hands both supported — enter any blind level, from 100/200 to 5M/10M. Study, share, and plug the leaks.",
  "@aboutFeatureReplayerBody": {
    "description": "About feature body."
  },
  "aboutFeatureAiTitle": "AI Coaching",
  "@aboutFeatureAiTitle": {
    "description": "About feature title."
  },
  "aboutFeatureAiBody": "Get a coaching breakdown of any recorded hand or session. The AI reviews your lines, flags sizing mistakes, and gives you something to think about before your next session. Like a coach, but available at 2am.",
  "@aboutFeatureAiBody": {
    "description": "About feature body."
  },
  "aboutFeatureReadsTitle": "Player Reads",
  "@aboutFeatureReadsTitle": {
    "description": "About feature title (reads = notes on opponents)."
  },
  "aboutFeatureReadsBody": "Your private database of tells, tendencies, and opponent notes. The felt has a memory — now so do you. Names autocomplete in the hand recorder so your reads stay connected to the hands they came from.",
  "@aboutFeatureReadsBody": {
    "description": "About feature body."
  },
  "aboutFeatureCalendarTitle": "Tournament Calendar",
  "@aboutFeatureCalendarTitle": {
    "description": "About feature title."
  },
  "aboutFeatureCalendarBody": "Upcoming live tournaments worldwide, updated weekly from PokerNews. WSOP, WPT, EPT, and regional series — filter by country and never miss an event worth playing.",
  "@aboutFeatureCalendarBody": {
    "description": "About feature body; PokerNews, WSOP, WPT, EPT are names — keep them."
  },
  "aboutFeatureIcmTitle": "ICM Deal Calculator",
  "@aboutFeatureIcmTitle": {
    "description": "About feature title."
  },
  "aboutFeatureIcmBody": "When the final table bubbles down to a deal, know your number. The ICM calculator uses the Malmuth-Harville model to compute fair deals based on chip counts and remaining prizes — up to 9 players, instantly.",
  "@aboutFeatureIcmBody": {
    "description": "About feature body."
  },
  "aboutFeatureEquityTitle": "Equity Calculator",
  "@aboutFeatureEquityTitle": {
    "description": "About feature title."
  },
  "aboutFeatureEquityBody": "Hand vs range equity, calculated across all run-outs. Know whether you're 60/40 or 40/60 before you make the call.",
  "@aboutFeatureEquityBody": {
    "description": "About feature body."
  },
  "aboutFeatureCurrencyTitle": "Multi-Currency Bankroll",
  "@aboutFeatureCurrencyTitle": {
