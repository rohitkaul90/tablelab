# Supabase credentials — never commit
lib/config/supabase_config.dart

# Eval harness run artifacts (regenerated by tool/eval/score.ts; fixtures ARE committed)
tool/eval/reports/

# Flutter DevTools generated settings
devtools_options.yaml

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Scratch/dev-only directories
/test_imports/

# Build artifacts (signed AABs are produced by CI + attached to GitHub Releases)
/dist/

# Android release keystore — never commit
android/app/tablelab-release.jks
android/build/
supabase/.temp/

# Cursor IDE
.cursor/

# Logo design files
logo_concepts/

# Launch ops (tester lists contain PII — keep out of the repo)
launch/

# Crash reports pasted from Crashlytics for debugging (may contain PII)
crash_reports/

# Launcher atomic-pull scratch dirs (a killed pull can strand one under assets/)
.pull-tmp-*/

marketing/
