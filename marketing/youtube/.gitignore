# marketing/youtube — keep source/text + light assets in git; keep heavy,
# regenerable media OUT (it lives on disk + YouTube). See memory/youtube-channel.

# Video / audio (final cut, VO stems, music bed, screen recordings)
*.mp4
*.mov
*.mkv
*.wav
*.mp3

# Oversized thumbnail source renders (5–7 MB each).
# The <2 MB YouTube export (idea-01-primary-yt.jpg) and the small *_thumb.jpeg
# previews are NOT ignored — they stay tracked.
thumbnails/*.png
